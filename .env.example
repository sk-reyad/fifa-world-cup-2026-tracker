# Required for live score/official standings/bracket update through the Vercel API proxy.
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here

# Default is 23706 based on Sportmonks' pre-kickoff checklist.
# If your Sportmonks dashboard/docs show a different World Cup 2026 season ID, set it here.
SPORTMONKS_SEASON_ID=23706

# Optional override. Keep default unless Sportmonks tells you otherwise.
SPORTMONKS_API_BASE=https://api.sportmonks.com/v3/football
